{
  "name": "@the-ark/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "test -s public/basemap/kantipur.pmtiles || ../../scripts/fetch-basemap.sh",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false"
  },
  "dependencies": {
    "@fontsource/inter": "latest",
    "@fontsource/space-mono": "latest",
    "@protomaps/basemaps": "^5.7.2",
    "@the-ark/shared-types": "file:../../packages/shared-types",
    "lucide-react": "latest",
    "maplibre-gl": "^6.10.0",
    "pmtiles": "^4.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "latest",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
