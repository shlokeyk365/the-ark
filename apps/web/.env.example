# API origin. Leave as /api to use the Vite dev proxy.
VITE_API_BASE_URL=/api

# ---------------------------------------------------------------- basemap
# The basemap is keyless. Nothing below is required for local development
# once `npm run basemap` has produced the PMTiles archive.

# Vector basemap archive. Same-origin static file by default; point this at
# object storage (S3, R2, any static host that supports range requests) in
# production.
# VITE_BASEMAP_PMTILES=/basemap/kantipur.pmtiles

# Place-label language. Required by the style generator; "ne" renders Nepali.
# VITE_BASEMAP_LANG=en

# Glyphs and sprites for the Protomaps basemap. Self-host from
# https://github.com/protomaps/basemaps-assets if you need zero third-party
# requests.
# VITE_BASEMAP_GLYPHS=https://protomaps.github.io/basemaps-assets/fonts/{fontstack}/{range}.pbf
# VITE_BASEMAP_SPRITE=https://protomaps.github.io/basemaps-assets/sprites/v4/dark

# Terrarium-encoded DEM for the 3D terrain toggle (AWS Open Data, no key).
# VITE_TERRAIN_TILES=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png

# Satellite imagery layer. Esri World Imagery by default — confirm its terms of
# use for your deployment, or point at another raster service.
# VITE_SATELLITE_TILES=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
